# Nebius Token Factory (OpenAI-compatible). Create a key at https://tokenfactory.nebius.com
NEBIUS_API_KEY=
NEBIUS_BASE_URL=https://api.tokenfactory.nebius.com/v1/

# Confirm exact IDs for your account: python scripts/list_models.py nemotron
MODEL_FAST=nvidia/NVIDIA-Nemotron-3-Nano-30B-A3B
MODEL_SMART=nvidia/Nemotron-3-Ultra-550b-a55b

# Optional: web search enrichment for the analyst (https://tavily.com)
TAVILY_API_KEY=

# If a model "thinks" too long on page generation, add its reasoning-off switch, for example:
# LLM_EXTRA_BODY={"chat_template_kwargs": {"enable_thinking": false}}

MIRAGE_MODE=mirage
DB_PATH=mirage.db
PORT=8080
LLM_TIMEOUT_S=30
